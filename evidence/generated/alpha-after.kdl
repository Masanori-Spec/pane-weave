// PaneWeave: review before loading; Zellij may run commands and load plugins.
layout {
// module: frames
pane_template name="topBar" borderless=true {
    plugin location="zellij:tab-bar"
}
pane_template name="bottomBar" borderless=true {
    plugin location="zellij:status-bar"
}
default_tab_template {
    topBar size=1
    children
    bottomBar size=1
}

// module: tools
pane_template name="editorPane" command="nvim" {
    args "--clean" "notes with spaces.md"
}
pane_template name="testPane" command="make" {
    args "test" "-race"
}

// module: tabs
tab_template name="devTab" {
    topBar size=1
    children
    bottomBar size=1
}

// project: alpha
devTab name="Dev" cwd="/work/alpha" focus=true {
    editorPane focus=true
    testPane
}

}
